{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "es2020"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "tests/unit/**/*.ts"
  ]
}
