# ===== Firebase 클라이언트 (Vercel 환경변수에 그대로 등록) =====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ===== 서버 전용 =====
# 교사 가입 인증 코드 (서버에서만 검증됨 — 절대 NEXT_PUBLIC_ 붙이지 말 것)
TEACHER_SIGNUP_CODE=

# Firebase 서비스 계정 JSON 전체를 한 줄로 (Vercel 환경변수)
# Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
FIREBASE_SERVICE_ACCOUNT=

# NEIS 오픈API 키 (선택 — 없으면 키 없이 호출, 급식/학교검색 호출량 제한 있음)
# https://open.neis.go.kr 에서 무료 발급
NEIS_SERVICE_KEY=

# ===== 로컬 에뮬레이터 개발용 =====
# NEXT_PUBLIC_USE_EMULATOR=1
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
