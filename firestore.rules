rules_version = '2';

// ─────────────────────────────────────────────────────────────
// 클래스메이트 Firestore 보안 규칙
// 원칙: 기본 거부(deny by default). 필요한 경로만 명시적으로 허용합니다.
// 배포: firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 공통 헬퍼 함수 ──────────────────────────────────────

    // 로그인했는지
    function signedIn() {
      return request.auth != null;
    }

    // 요청자가 해당 uid 본인인지
    function me(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 특정 사용자의 users 문서 데이터 (get 호출 — 문서가 없으면 규칙은 거부됩니다)
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // 요청자 본인의 users 문서 데이터
    function myDoc() {
      return userDoc(request.auth.uid);
    }

    // 요청자가 교사인지
    function isTeacher() {
      return signedIn() && myDoc().role == 'teacher';
    }

    // 요청자가 해당 학교(schoolCode) 소속인지
    function sameSchool(schoolCode) {
      return signedIn() && myDoc().schoolCode == schoolCode;
    }

    // 학급 문서 데이터
    function classDoc(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    // 요청자가 해당 학급의 담임 교사인지
    function isClassTeacher(classId) {
      return signedIn() && classDoc(classId).teacherId == request.auth.uid;
    }

    // 요청자가 이 반의 승인된 학생인지 (본반 또는 추가 참여 반)
    function isClassStudent(classId) {
      return signedIn()
        && myDoc().role == 'student'
        && myDoc().status == 'approved'
        && (myDoc().classId == classId
            || (('extraClassIds' in myDoc()) && classId in myDoc().extraClassIds));
    }

    // ── users/{uid}: 사용자 프로필 ──────────────────────────
    match /users/{uid} {
      // 생성: 클라이언트는 만들 수 없습니다 — 서버(API)만 생성합니다.
      //       교사는 /api/complete-signup(코드 검증), 학생은 /api/join(QR 토큰 검증).
      //       클라이언트가 role/schoolCode를 스스로 정해 타학교 명단을 읽는 공격 차단.
      allow create: if false;

      // 읽기: 본인 / 같은 학교의 교사 / 그 학생의 담임 교사
      allow read: if me(uid)
        || (isTeacher() && sameSchool(resource.data.schoolCode))
        || (isTeacher() && resource.data.role == 'student'
            && classDoc(resource.data.classId).teacherId == request.auth.uid);

      // 수정(본인): role은 절대 변경할 수 없습니다.
      //            학생은 자신의 status/classId/추가 반/반 이동 신청 필드도 스스로 바꿀 수 없습니다
      //            (반 이동 신청은 /api/join, 승인·거절은 새 반 담임이 /api/class-membership으로).
      //            schoolCode는 한 번 정해지면 바꿀 수 없습니다(타학교 명단 열람 방지).
      //            (fcmTokens, mySchedule, displayName 등은 자유롭게 수정 가능)
      allow update: if me(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(resource.data.role == 'student'
               ? ['role', 'status', 'classId', 'extraClassIds', 'pendingClassId', 'pendingStudentId', 'pendingAt']
               : ['role'])
        && (!('schoolCode' in resource.data)
            || request.resource.data.schoolCode == resource.data.schoolCode);

      // 수정(교사): 승인/거절 흐름 — 같은 학교 교사면 가능
      //             (교과 교사가 수업 반 학생을 초대·승인하는 흐름 + 담임 미정 반 처리)
      //             status/classId/grade/classNm 필드만 바꿀 수 있습니다.
      allow update: if isTeacher()
        && resource.data.role == 'student'
        && sameSchool(resource.data.schoolCode)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'classId', 'grade', 'classNm']);

      // 삭제: 본인만
      allow delete: if me(uid);

      // ── users/{uid}/notifications/{nid}: 알림함 ──────────
      match /notifications/{nid} {
        // 생성: 알림 주인과 같은 학교의 로그인 사용자 누구나 (교체/SOS/공지 알림 전달용)
        //       앱이 쓰는 형식{title, body, url, createdAt, read:false}만 허용하고,
        //       url은 앱 내부 상대 경로만 받습니다. (검사가 없으면 알림을 위조하거나
        //       javascript:·외부 링크를 심어 알림함에서 누르게 만들 수 있었습니다.)
        allow create: if signedIn()
          && myDoc().schoolCode == userDoc(uid).schoolCode
          && request.resource.data.keys().hasOnly(['title', 'body', 'url', 'createdAt', 'read'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 500
          && (!('url' in request.resource.data)
              || request.resource.data.url == null
              || (request.resource.data.url is string
                  && request.resource.data.url.size() <= 300
                  && request.resource.data.url.matches('^/([^/\\\\][^\\\\]*)?$')))
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time;

        // 읽기/삭제: 알림 주인만
        allow read, delete: if me(uid);

        // 수정: 알림 주인만, 읽음(read) 플래그만 변경 가능
        allow update: if me(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['read']);
      }

      // ── users/{uid}/bagChecks/{ymd}: 가방(준비물) 체크 ────
      // {items: 준비물명→boolean 맵, done, updatedAt}
      match /bagChecks/{ymd} {
        // 읽기/쓰기: 본인만
        allow read, write: if me(uid);
      }
    }

    // ── classes/{classId}: 학급 ─────────────────────────────
    match /classes/{classId} {
      // 읽기: 같은 학교의 로그인 사용자 (학생 가입 흐름에서 학급 정보 확인 포함)
      allow read: if signedIn() && sameSchool(resource.data.schoolCode);

      // 생성: 교사가 자기 자신을 teacherId로 지정할 때만.
      //       학교가 정해진 교사는 자기 학교의 반만 만들 수 있습니다(타학교 반 선점 방지).
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && (myDoc().get('schoolCode', null) == null
            || request.resource.data.get('schoolCode', null) == myDoc().schoolCode);

      // 수정: 담임 교사만. teacherId는 유지하거나(일반 수정)
      //       null로 비울 수만 있습니다(반 변경 시 담임 자리 해제).
      allow update: if signedIn()
        && resource.data.teacherId == request.auth.uid
        && (request.resource.data.teacherId == request.auth.uid
            || request.resource.data.teacherId == null)
        && (!('schoolCode' in resource.data)
            || request.resource.data.get('schoolCode', null) == resource.data.schoolCode);

      // 수정(인수): 아직 담임이 없는 반(teacherId 없음/null)은
      //             교사가 자신을 담임으로 지정하며 넘겨받을 수 있습니다.
      //             같은 학교 교사만 인수할 수 있습니다. (학교 검사가 없으면 다른 학교 교사가
      //             담임 없는 반을 가로채 그 반 학생 정보·톡방을 열람할 수 있었습니다.)
      //             schoolCode가 없는 예전 반은 classId 첫 토막(학교 코드)으로 판정합니다.
      allow update: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && (!('teacherId' in resource.data) || resource.data.teacherId == null)
        && (myDoc().get('schoolCode', null) == null
            || myDoc().schoolCode == resource.data.get('schoolCode', classId.split('_')[0]))
        && (!('schoolCode' in resource.data)
            || request.resource.data.get('schoolCode', null) == resource.data.schoolCode);

      // 삭제: 담임 교사만
      allow delete: if signedIn() && resource.data.teacherId == request.auth.uid;

      // ── classes/{classId}/info/{infoId}: 시간표 등 학급 정보 ──
      match /info/{infoId} {
        // 읽기: 같은 학교의 로그인 사용자 (학급 구성원 + 학교 교사)
        allow read: if signedIn() && sameSchool(classDoc(classId).schoolCode);
        // 쓰기: 담임 교사만
        allow write: if isClassTeacher(classId);
      }

      // ── classes/{classId}/announcements/{aid}: 알림장(공지) ──
      match /announcements/{aid} {
        // 읽기: 담임 교사 / 같은 학교 교사 / 이 학급에 승인된 학생
        allow read: if isClassTeacher(classId)
          || (isTeacher() && sameSchool(classDoc(classId).schoolCode))
          || isClassStudent(classId);

        // 생성: 같은 학교 교사(담임 + 수업 교사), 본인 명의
        allow create: if isTeacher()
          && sameSchool(classDoc(classId).schoolCode)
          && request.resource.data.authorId == request.auth.uid;
        // 수정/삭제: 담임 또는 작성자 본인
        allow update, delete: if isClassTeacher(classId)
          || (isTeacher() && resource.data.authorId == request.auth.uid);

        // 예외: 이 반의 승인된 학생은 읽음 카운터(readCount)만 +1 할 수 있음
        allow update: if isClassStudent(classId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount'])
          && request.resource.data.readCount ==
             (('readCount' in resource.data) ? resource.data.readCount + 1 : 1);

        // 예외: 확인 체크 카운터(checkCount)도 +1만 가능
        allow update: if isClassStudent(classId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkCount'])
          && request.resource.data.checkCount ==
             (('checkCount' in resource.data) ? resource.data.checkCount + 1 : 1);

        // ── comments/{cid}: 알림장 댓글(의견 나누기) ──
        match /comments/{cid} {
          // 읽기: 알림장을 읽을 수 있는 사람과 동일
          allow read: if isClassTeacher(classId)
            || (isTeacher() && sameSchool(classDoc(classId).schoolCode))
            || isClassStudent(classId);

          // 생성: 담임 또는 이 반의 승인된 학생, 본인 명의 + 500자 제한
          allow create: if (isClassTeacher(classId)
              || isClassStudent(classId))
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            // 작성 시각은 서버 시각, 역할 표시는 실제 계정 역할과 일치해야 합니다.
            // (검사가 없으면 학생이 role:'teacher'로 선생님 행세를 하거나,
            //  createdAt을 먼 미래로 넣어 목록 맨 아래에 고정할 수 있었습니다.)
            && request.resource.data.createdAt == request.time
            && request.resource.data.role == (myDoc().role == 'teacher' ? 'teacher' : 'student')
            && request.resource.data.authorName is string
            && request.resource.data.authorName.size() <= 50
            && request.resource.data.keys()
                 .hasOnly(['authorId', 'authorName', 'role', 'text', 'createdAt']);

          // 삭제: 본인 또는 담임(중재용). 수정은 불가.
          allow delete: if signedIn()
            && (resource.data.authorId == request.auth.uid || isClassTeacher(classId));
          allow update: if false;
        }

        // ── receipts/{studentUid}: 읽음 확인 + 동의 여부 ──
        match /receipts/{studentUid} {
          // 생성/수정: 이 반의 승인된 학생 본인만, 허용된 필드만 기록 가능.
          // isClassStudent 검사가 없으면 로그인한 누구나 아무 반의 알림장에
          // 자기 uid로 receipt를 만들 수 있어, 교사 확인 명단이 오염됩니다.
          allow create, update: if me(studentUid)
            && isClassStudent(classId)
            && request.resource.data.keys()
                 .hasOnly(['readAt', 'studentName', 'consent', 'consentAt'])
            // 값 타입까지 확인 — 이상한 값이 들어가면 교사 화면이 깨지거나 이름이 위조됩니다.
            && request.resource.data.studentName is string
            && request.resource.data.studentName.size() <= 50
            && (!('readAt' in request.resource.data) || request.resource.data.readAt is timestamp)
            && (!('consent' in request.resource.data)
                || request.resource.data.consent in ['agreed', 'declined'])
            && (!('consentAt' in request.resource.data)
                || request.resource.data.consentAt is timestamp);

          // 읽기: 같은 학교 교사(담임+수업 교사·확인 명단용)와 학생 본인
          allow read: if me(studentUid)
            || (isTeacher() && sameSchool(classDoc(classId).schoolCode));
        }
      }

      // ── classes/{classId}/chat/{mid}: 우리 반 이야기방 메시지 ──
      match /chat/{mid} {
        // 읽기: 같은 학교 교사(담임+수업 교사) / 이 반의 승인된 학생
        allow read: if (isTeacher() && sameSchool(classDoc(classId).schoolCode))
          || isClassStudent(classId);

        // 생성: 같은 학교 교사 또는 이 반의 승인된 학생, 본인 명의 + 500자 제한
        allow create: if ((isTeacher() && sameSchool(classDoc(classId).schoolCode))
            || isClassStudent(classId))
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          // 작성 시각은 서버 시각, 역할 표시는 실제 계정 역할과 일치해야 합니다.
          && request.resource.data.createdAt == request.time
          && request.resource.data.role == (myDoc().role == 'teacher' ? 'teacher' : 'student')
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 50
          && request.resource.data.keys()
               .hasOnly(['authorId', 'authorName', 'role', 'text', 'createdAt']);

        // 삭제: 본인 또는 담임(중재). 수정 불가.
        allow delete: if signedIn()
          && (resource.data.authorId == request.auth.uid || isClassTeacher(classId));
        allow update: if false;
      }

      // ── classes/{classId}/overrides/{ymd}: 시간표 변경(보강/교체) ──
      match /overrides/{ymd} {
        // 읽기: 이 학급 구성원(classId 일치) + 같은 학교 교사
        allow read: if signedIn()
          && (myDoc().classId == classId
              || (myDoc().role == 'teacher'
                  && myDoc().schoolCode == classDoc(classId).schoolCode));

        // 쓰기: 같은 학교 교사 누구나 (교체 수락 시 양쪽 학급에 기록되기 때문)
        allow write: if isTeacher() && sameSchool(classDoc(classId).schoolCode);
      }

      // ── classes/{classId}/joinTokens/{token}: 학생 가입 토큰 ──
      match /joinTokens/{token} {
        // 읽기 금지: 토큰 검증은 서버(/api/join-info, /api/join)가 admin으로 수행.
        // (클라이언트 읽기를 열면 목록 조회로 유효 토큰이 유출될 수 있음)
        allow read: if false;
        // 쓰기: 같은 학교 교사 (담임 + 수업 들어가는 교과 교사의 QR 발급)
        // 만료는 서버가 createdAt + 10분으로 판정하므로 createdAt은 서버 시각만 허용합니다.
        // (update도 막아야 발급 후 createdAt을 미래로 바꿔 유효기간을 늘리지 못함)
        allow create, update: if isTeacher() && sameSchool(classDoc(classId).schoolCode)
          && request.resource.data.createdAt == request.time;
        allow delete: if isTeacher() && sameSchool(classDoc(classId).schoolCode);
      }
    }

    // ── school_swaps/{schoolCode}: 수업 교환 ─────────────────
    // direct_requests: 특정 선생님에게 보낸 1:1 요청 / requests: 학교 게시판 공개 요청
    // slots/{uid}_{date}_{period}: 교환 수락·SOS 배정으로 채워진 칸 잠금
    // 읽기는 같은 학교 교사, 상태 변경은 정해진 사람이 정해진 필드만 바꿀 수 있습니다.
    // (예전 규칙은 같은 학교 교사면 남의 요청을 대신 수락·취소·삭제하거나 내용을 고칠 수 있었습니다.)
    match /school_swaps/{schoolCode} {
      function swapTeacher() {
        return isTeacher() && sameSchool(schoolCode);
      }
      // 아직 처리되지 않은 요청 (status 없는 예전 문서는 대기로 봄 — 앱의 normalizeStatus와 같음)
      function swapOpen() {
        return !(resource.data.get('status', 'pending') in ['accepted', 'declined', 'cancelled']);
      }
      function swapRequester() {
        return resource.data.get('requesterId', resource.data.get('fromId', null));
      }
      function changedOnly(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }
      function hasSlot(data) {
        return data.get('date', null) is string && data.date.matches('^[0-9]{8}$')
          && data.get('period', null) is int && data.period > 0;
      }
      // 날짜·교시가 있는 요청은 같은 트랜잭션에서 내 칸 잠금(이 요청을 가리킴)도 만들어야 수락됩니다.
      function lockedFor(data, refPath) {
        return !hasSlot(data)
          || getAfter(/databases/$(database)/documents/school_swaps/$(schoolCode)/slots/$(request.auth.uid + '_' + data.date + '_' + string(data.period))).data.refPath == refPath;
      }
      function acceptOk() {
        return changedOnly(['status', 'acceptedAt', 'accepterId', 'accepterName'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.accepterId == request.auth.uid
          && request.resource.data.acceptedAt == request.time;
      }
      function cancelOk() {
        return swapRequester() == request.auth.uid
          && changedOnly(['status', 'cancelledAt'])
          && request.resource.data.status == 'cancelled';
      }

      match /direct_requests/{rid} {
        allow read: if swapTeacher();
        allow create: if swapTeacher()
          && request.resource.data.keys().hasOnly(['fromId', 'fromName', 'requesterId', 'requesterName',
               'requesterClassId', 'requesterClass', 'toId', 'toName', 'day', 'dayLabel', 'period',
               'subject', 'date', 'note', 'status', 'createdAt'])
          && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.get('fromId', request.auth.uid) == request.auth.uid
          && request.resource.data.toId is string
          && request.resource.data.toId != request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        // 수락: 받은 선생님만
        allow update: if swapTeacher() && swapOpen()
          && resource.data.get('toId', null) == request.auth.uid
          && acceptOk()
          && lockedFor(resource.data, 'school_swaps/' + schoolCode + '/direct_requests/' + rid);
        // 거절: 받은 선생님만
        allow update: if swapTeacher() && swapOpen()
          && resource.data.get('toId', null) == request.auth.uid
          && changedOnly(['status', 'declinedAt', 'declinerId', 'declinerName'])
          && request.resource.data.status == 'declined'
          && request.resource.data.declinerId == request.auth.uid;
        // 취소: 보낸 선생님만
        allow update: if swapTeacher() && swapOpen() && cancelOk();
        allow delete: if false;
      }

      match /requests/{rid} {
        allow read: if swapTeacher();
        allow create: if swapTeacher()
          && request.resource.data.keys().hasOnly(['requesterId', 'requesterName', 'requesterClassId',
               'requesterClass', 'day', 'dayLabel', 'period', 'subject', 'date', 'note', 'status', 'createdAt'])
          && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        // 수락(선착순): 올린 사람이 아닌 같은 학교 교사
        allow update: if swapTeacher() && swapOpen()
          && swapRequester() != request.auth.uid
          && acceptOk()
          && lockedFor(resource.data, 'school_swaps/' + schoolCode + '/requests/' + rid);
        // 취소: 올린 선생님만
        allow update: if swapTeacher() && swapOpen() && cancelOk();
        allow delete: if false;
      }

      // 칸 잠금: 수락·배정 트랜잭션이 만든 결과(이 요청을 내가 수락/배정받음)와 맞을 때만 생성.
      // 교환은 수락 교사가 요청 교사 칸까지 잠그므로 uid는 나 또는 그 요청의 요청 교사.
      // 한 번 잡힌 칸은 고치거나 지울 수 없습니다(수락 취소 기능이 생기면 해제 규칙을 함께 추가).
      function swapLockOk(lock, s) {
        return s.get('status', '') == 'accepted'
          && s.get('accepterId', '') == request.auth.uid
          && s.get('date', '') == lock.date
          && string(s.get('period', '')) == string(lock.period)
          && (lock.uid == request.auth.uid || lock.uid == s.get('requesterId', s.get('fromId', '')));
      }
      function sosLockOk(lock, s) {
        return s.get('status', '') == 'assigned'
          && s.get('assignedTo', '') == request.auth.uid
          && lock.uid == request.auth.uid
          && s.get('date', '') == lock.date
          && string(s.get('period', '')) == string(lock.period);
      }
      function lockBacked(lock, p) {
        return p.size() == 4 && p[1] == schoolCode && (
          (lock.kind == 'swap' && p[0] == 'school_swaps' && p[2] in ['direct_requests', 'requests']
            && swapLockOk(lock, getAfter(/databases/$(database)/documents/school_swaps/$(schoolCode)/$(p[2])/$(p[3])).data))
          || (lock.kind == 'sos' && p[0] == 'school_sos' && p[2] == 'requests'
            && sosLockOk(lock, getAfter(/databases/$(database)/documents/school_sos/$(schoolCode)/requests/$(p[3])).data)));
      }

      match /slots/{slotId} {
        allow read: if swapTeacher();
        allow create: if swapTeacher()
          && request.resource.data.keys().hasOnly(['uid', 'date', 'period', 'kind', 'refPath', 'createdAt'])
          && request.resource.data.uid is string
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{8}$')
          && request.resource.data.period is int
          && request.resource.data.period > 0
          && slotId == request.resource.data.uid + '_' + request.resource.data.date + '_' + string(request.resource.data.period)
          && request.resource.data.createdAt == request.time
          && request.resource.data.refPath is string
          && lockBacked(request.resource.data, request.resource.data.refPath.split('/'));
        allow update, delete: if false;
      }
    }

    // ── school_sos/{schoolCode}/requests: 긴급 보결(SOS) 요청 ─────
    match /school_sos/{schoolCode}/requests/{rid} {
      function sosTeacher() {
        return isTeacher() && sameSchool(schoolCode);
      }
      allow read: if sosTeacher();
      allow create: if sosTeacher()
        && request.resource.data.keys().hasOnly(['date', 'period', 'reason', 'requesterId', 'requesterName',
             'requesterClass', 'schoolCode', 'status', 'createdAt'])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.get('schoolCode', schoolCode) == schoolCode
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      // 맡기(선착순): 올린 사람이 아닌 교사. 날짜·교시가 있으면 같은 트랜잭션에서 내 칸 잠금도 만들어야 함
      allow update: if sosTeacher()
        && resource.data.get('status', 'open') == 'open'
        && resource.data.get('requesterId', null) != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'assignedTo', 'assignedName', 'assignedAt'])
        && request.resource.data.status == 'assigned'
        && request.resource.data.assignedTo == request.auth.uid
        && request.resource.data.assignedAt == request.time
        && (!(resource.data.get('date', null) is string && resource.data.date.matches('^[0-9]{8}$')
              && resource.data.get('period', null) is int && resource.data.period > 0)
            || getAfter(/databases/$(database)/documents/school_swaps/$(schoolCode)/slots/$(request.auth.uid + '_' + resource.data.date + '_' + string(resource.data.period))).data.refPath
                 == 'school_sos/' + schoolCode + '/requests/' + rid);
      // 취소: 올린 사람만, 모집 중일 때
      allow update: if sosTeacher()
        && resource.data.get('requesterId', null) == request.auth.uid
        && resource.data.get('status', 'open') == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && request.resource.data.status == 'cancelled';
      allow delete: if false;
    }

    // ── school_timetables/{schoolCode}: 엑셀 업로드 학교 시간표 마스터 ──
    // 쓰기는 서버(API 라우트, firebase-admin)에서만 하고,
    // 같은 학교 교사는 읽어서 자기 시간표를 불러갈 수 있습니다.
    match /school_timetables/{schoolCode} {
      allow read: if isTeacher() && sameSchool(schoolCode);
      allow write: if false;
    }

    // ── meal_ratings/{docId}: 급식 별점 (다음 단계 기능 대비) ──
    // 익명 로그인 포함, 로그인만 하면 읽기/집계 카운터 갱신 가능
    match /meal_ratings/{docId} {
      allow read: if signedIn();

      // 집계 문서는 같은 트랜잭션에서 내 투표(votes/{uid})를 처음 남길 때만,
      // 그 투표 점수만큼만 늘릴 수 있습니다. (예전 규칙은 로그인만 하면 익명 계정도
      // 집계를 임의 값으로 덮어써 별점과 TOP5를 조작할 수 있었습니다.)
      function myVote() {
        return /databases/$(database)/documents/meal_ratings/$(docId)/votes/$(request.auth.uid);
      }
      function newVoteRating() {
        return getAfter(myVote()).data.rating;
      }

      allow create: if signedIn()
        && !exists(myVote()) && existsAfter(myVote())
        && request.resource.data.keys().hasOnly(['schoolCode', 'date', 'sum', 'total', 'counts'])
        && docId == request.resource.data.schoolCode + '_' + request.resource.data.date
        && request.resource.data.total == 1
        && request.resource.data.sum == newVoteRating()
        && request.resource.data.counts.keys().hasOnly([string(newVoteRating())])
        && request.resource.data.counts[string(newVoteRating())] == 1;

      allow update: if signedIn()
        && !exists(myVote()) && existsAfter(myVote())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sum', 'total', 'counts'])
        && request.resource.data.total == resource.data.get('total', 0) + 1
        && request.resource.data.sum == resource.data.get('sum', 0) + newVoteRating()
        && request.resource.data.counts.diff(resource.data.get('counts', {})).affectedKeys()
             .hasOnly([string(newVoteRating())])
        && request.resource.data.counts[string(newVoteRating())]
             == resource.data.get('counts', {}).get(string(newVoteRating()), 0) + 1;

      // ── votes/{uid}: 계정당 1표 투표 기록 ────────────────
      match /votes/{uid} {
        // 읽기: 본인 투표만 (중복 참여 확인용)
        allow read: if me(uid);

        // 생성: 본인 명의로, rating은 1~5 정수만 가능.
        //       익명 계정은 투표할 수 없습니다(익명 계정을 계속 새로 만들어 별점·TOP5를 조작하던 경로 차단).
        allow create: if me(uid)
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;

        // 수정/삭제 불가: 한 번 남긴 투표는 되돌릴 수 없습니다.
        allow update, delete: if false;
      }
    }

    // ── 그 외 모든 경로: 기본 거부 ──────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
